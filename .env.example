# ---------------------------------------------------------------------------
# AgriFlow B2B — environment configuration
#
# DEMO MODE:
#   Leave VITE_FIREBASE_API_KEY empty (or set VITE_DEMO_MODE=true) to run the
#   app fully in-browser against a seeded, Firestore-shaped mock data layer.
#   No backend required. Demo credentials are shown on the login screen.
#
# LIVE MODE:
#   Fill in your Firebase Web App config below and set VITE_DEMO_MODE=false.
# ---------------------------------------------------------------------------

VITE_DEMO_MODE=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
