rules_version = '2';

// ---------------------------------------------------------------------------
// AgriFlow B2B — Firestore security rules
//
// Role is read from the Auth token custom claims:
//   request.auth.token.role        -> 'super_admin' | 'staff' | 'retailer'
//   request.auth.token.status      -> 'ACTIVE' for approved retailers
// Claims are set by the `approveRetailer` / `setStaffRole` Cloud Functions.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return request.auth.token.role;
    }
    function isAdmin() {
      return isSignedIn() && role() == 'super_admin';
    }
    function isStaff() {
      return isSignedIn() && (role() == 'staff' || role() == 'super_admin');
    }
    function isActiveRetailer() {
      return isSignedIn() && role() == 'retailer'
        && request.auth.token.status == 'ACTIVE';
    }

    // ---- users -----------------------------------------------------------
    match /users/{uid} {
      // A user can read their own doc; staff can read all.
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == uid);
      // Self-registration: a user may create their own PENDING doc.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.status == 'PENDING_APPROVAL'
        && request.resource.data.role == 'retailer';
      // Retailers may update limited profile fields; staff manage everything.
      allow update: if isStaff()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // ---- products + batches ---------------------------------------------
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();

      match /batches/{batchId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isStaff();
      }
    }

    // ---- orders ----------------------------------------------------------
    match /orders/{orderId} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.retailerId == request.auth.uid);
      // Retailers create their own SUBMITTED orders.
      allow create: if isActiveRetailer()
        && request.resource.data.retailerId == request.auth.uid
        && request.resource.data.status == 'SUBMITTED';
      // Only staff advance the lifecycle / modify quantities.
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ---- inventory logs (write via staff/functions, read by staff) -------
    match /inventory_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ---- credit ledgers --------------------------------------------------
    match /credit_ledgers/{entryId} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.retailerId == request.auth.uid);
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ---- announcements & rake arrivals (public read to signed-in) --------
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }
    match /rake_arrivals/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }
  }
}
